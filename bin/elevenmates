#!/usr/bin/env python3
"""Score fetcher behind the Elevenmates bar widget.

Talks to ESPN's public scoreboard endpoints, which need no key and no account,
and to Sofascore for the competitions ESPN does not carry - Ekstraklasa is the
only one so far. One request per followed competition, run in parallel, folded
into a single cache file the QML side watches. A competition that fails keeps
its previous matches instead of blanking the bar.

Settings live in ~/.config/omarchy/elevenmates.json rather than in the widget's
shell.json entry: `omarchy bar set` hands its value to the shell over an IPC
call that flattens a JSON array into separate arguments, so a list of
competitions came back as a bare string, or not at all.

Commands:
  fetch    refresh the score cache [--stats <league>:<event>]
  config   show | set <key> <json-value> | get <key>
  leagues  print the competition picker options as JSON
  teams    print the team picker options as JSON
  demo-goal  fire the goal alert once
"""

import argparse
import errno
import fcntl
import gzip
import http.client
import io
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import zlib
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from urllib.parse import urlsplit

# Everything a request can fail with, in one place: the pooled connections
# raise http.client's exceptions, which are not OSErrors.
NETWORK_ERRORS = (
    urllib.error.URLError,
    http.client.HTTPException,
    OSError,
    ValueError,
    TimeoutError,
)

SITE_API = "https://site.api.espn.com/apis/site/v2/sports/soccer"

# ESPN publishes 219 soccer competitions and not one of them is Polish, so
# Ekstraklasa cannot come from the same place as everything else. Sofascore
# carries it, needs no key either, and answers the three things the widget
# actually needs: the round's fixtures, a running clock, and the scoring plays
# with the scorer on them. It is an undocumented endpoint and may change under
# us; a competition that fails keeps its previous matches, so the worst case is
# a stale Polish row rather than a broken bar.
SOFA_API = "https://api.sofascore.com/api/v1"

# Slug -> Sofascore "unique tournament" id. Everything not listed here goes to
# ESPN, which is still the source for the other forty-three competitions.
SOFA_TOURNAMENTS = {
    "pol.1": 202,
}

# Sofascore ids are its own numbering and would otherwise collide with ESPN's -
# 86 is Real Madrid over there and somebody else entirely here. The prefix
# keeps favourites, pins and bells unambiguous whichever source they came from.
# A dash rather than a colon: match ids travel through `--stats <league>:<id>`.
SOFA_PREFIX = "sofa-"

# The season the current round belongs to, so the fixture list can be asked
# for. It changes once a year; re-asking on every sweep would be a third of the
# competition's traffic for an answer that never moves.
SOFA_SEASON_CACHE = "sofascore.json"
SOFA_SEASON_AGE = 12 * 60 * 60

# One request per match for the scorers, so the sweep cannot grow without
# bound on a full matchday.
SOFA_MAX_DETAIL = 10

CONFIG_PATH = os.path.expanduser("~/.config/omarchy/elevenmates.json")
STATE_PATH = os.path.expanduser(
    "~/.local/state/omarchy/elevenmates/state.json"
)

DEFAULT_CONFIG = {
    "leagues": [
        "eng.1", "esp.1", "ger.1", "ita.1", "fra.1",
        "uefa.champions", "uefa.europa", "uefa.europa.conf",
        "uefa.nations", "fifa.worldq.uefa",
    ],
    "favoriteTeams": [],
    "pinnedMatch": "",
    "alertMatches": [],
    "barMode": "Auto",
    "goalNotifications": True,
    "notifyAll": False,
    "liveRefreshSec": 60,
    "idleRefreshMin": 20,
}
REQUEST_TIMEOUT = 12
MAX_PARALLEL_REQUESTS = 6

# A response is read in chunks against these two ceilings instead of being
# swallowed whole. The largest document either endpoint serves is the club
# list at 373 KB; a whole sweep of ten competitions is 70 KB compressed and
# 742 KB expanded. Anything an order of magnitude past that is not football,
# so the read stops there rather than letting a hostile or broken endpoint
# dribble bytes forever or hand back a gzip bomb.
MAX_BODY_BYTES = 4 * 1024 * 1024
MAX_DECOMPRESSED_BYTES = 16 * 1024 * 1024
READ_CHUNK_BYTES = 64 * 1024

# The widget exists once per monitor, each with its own timer, so two fetches
# can start within milliseconds of each other. They would double the traffic,
# announce every goal twice and race each other's writes. One lock and one
# freshness check collapse them into a single refresh.
LOCK_NAME = "fetch.lock"
MIN_REFRESH_AGE = 15

# A whole sweep has to finish in bounded time even if one endpoint dribbles
# bytes: urlopen's timeout is per socket operation, not a deadline.
FETCH_BUDGET = 40

# The club list changes about twice a year; fetching it on every visit to the
# settings tab cost 373 KB a time.
TEAMS_CACHE_NAME = "teams.json"
TEAMS_CACHE_AGE = 7 * 24 * 60 * 60

SLUG_PATTERN = re.compile(r"^[A-Za-z0-9._-]+$")

# A cache older than this was written before the machine slept. Diffing against
# it would replay hours of football as fresh goals.
STALE_CACHE_AGE = 20 * 60

# The longest the widget ever lets itself go between sweeps: it stretches the
# idle interval when today's card is empty and stretches it further overnight,
# and this is where that stops. The staleness guard above has to clear it, or a
# perfectly ordinary quiet night would be read as a suspend and the first goals
# of the morning would go unannounced. Mirrored by IDLE_STRETCH_CAP_MS in
# BarWidget.qml, which is the side that actually does the waiting.
IDLE_STRETCH_CAP = 45 * 60

# Goals wait their turn on the bar, so the cache carries a short feed rather
# than only the newest one: two goals inside a single refresh interval are two
# celebrations, not one. Deep enough for a busy Saturday minute, shallow enough
# that a widget starting up cannot inherit a whole afternoon.
GOAL_FEED_KEEP = 12

# How long a finished match stays on today's card once its day has rolled over.
# Model.js keeps FINISHED_GRACE_MS in step with this: a match the helper still
# writes out but the QML side has stopped offering the bar is a card that reads
# as stuck.
RECENT_MATCH_AGE = 5 * 60 * 60

# The open match card's numbers, kept per match. There is one widget per
# monitor and they can have different cards open, so a single slot meant each
# sweep overwrote the other screen's numbers and neither ever settled.
STATS_KEEP = 4
STATS_AGE = 15 * 60

# The picker list. ESPN carries 219 soccer competitions, most of them qualifying
# rounds and regional cups nobody scrolls past, so the widget offers a readable
# subset. Any other slug still works if it is put into the config file by hand.
COMPETITIONS = [
