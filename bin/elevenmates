COMPETITION_LABELS = {slug: label for slug, label, _ in COMPETITIONS}

# Rank used when sorting the cached list: what is happening now comes first.
STATE_ORDER = {"in": 0, "pre": 1, "post": 2}


# One TLS handshake per worker thread rather than one per request. A sweep of
# ten competitions paid for ten of them; with the picker's full list it was
# forty-three. The connections belong to the thread that opened them, so no two
# requests ever share a socket.
_pool = threading.local()


def take_connection(host, timeout):
    """Return (connection, reused). A reused one may already be half dead."""
    connections = getattr(_pool, "connections", None)
    if connections is None:
        connections = _pool.connections = {}
    connection = connections.get(host)
    reused = connection is not None
    if connection is None:
        connection = connections[host] = http.client.HTTPSConnection(
            host, timeout=timeout
        )
    # http.client only reads its timeout when it connects, so an already open
    # socket has to be told separately or it keeps the first call's deadline.
    connection.timeout = timeout
    if connection.sock is not None:
        try:
            connection.sock.settimeout(timeout)
        except OSError:
            pass
    return connection, reused


def drop_connection(host):
    connections = getattr(_pool, "connections", None) or {}
    connection = connections.pop(host, None)
    if connection is not None:
        try:
            connection.close()
        except OSError:
            pass


def read_body(response, deadline):
    """The response body, bounded in bytes and in wall clock time.

    response.read() with no argument keeps reading for as long as the far end
    keeps sending: the socket timeout limits one quiet stretch, not the whole
    transfer, so a slow trickle can outlive any deadline the sweep set itself.
    """
    chunks = []
    total = 0
    while True:
        if time.time() >= deadline:
            raise TimeoutError("response body outlived its deadline")
        chunk = response.read(READ_CHUNK_BYTES)
        if not chunk:
            return b"".join(chunks)
        total += len(chunk)
        if total > MAX_BODY_BYTES:
            raise ValueError("response body over %d bytes" % MAX_BODY_BYTES)
        chunks.append(chunk)


def gunzip_body(payload):
    """Expand a gzip body, refusing one that expands out of all proportion."""
    try:
        with gzip.GzipFile(fileobj=io.BytesIO(payload)) as stream:
            body = stream.read(MAX_DECOMPRESSED_BYTES + 1)
    except EOFError:
        # A body cut off mid-stream is a failed request like any other, and the
        # sweep only knows how to keep the previous matches for those.
        raise ValueError("response ended mid-gzip-stream")
    except zlib.error as error:
        # Corrupt deflate data raises outside the OSError family that the rest
        # of the fetch treats as a network failure, so it is translated here
        # rather than escaping every caller that only handles NETWORK_ERRORS.
        raise ValueError("response is not readable gzip: %s" % error)
    if len(body) > MAX_DECOMPRESSED_BYTES:
        raise ValueError(
            "response expands past %d bytes" % MAX_DECOMPRESSED_BYTES
        )
    return body


def read_json_url(url, deadline=None):
    """One scoreboard or summary document.

    No User-Agent override on purpose: ESPN's edge answers urllib's default but
    returns 403 for an arbitrary product token, and spoofing a browser is not
    worth it. If this ever starts failing, the header is the first place to
    look. Accept-Encoding is a separate header and is safe: these documents
    compress about tenfold, which is the difference between 742 KB and 70 KB
    for one sweep of ten competitions.
    """
    timeout = REQUEST_TIMEOUT
    if deadline is not None:
        timeout = max(1.0, min(REQUEST_TIMEOUT, deadline - time.time()))

    parts = urlsplit(url)
    host = parts.netloc
    target = parts.path + ("?" + parts.query if parts.query else "")
    # http.client sends no User-Agent of its own, and a request without one is
    # answered with 403. urllib's default token is accepted, so keep sending
    # exactly that; an arbitrary product token is refused as well.
    headers = {
        "User-Agent": "Python-urllib/%s" % urllib.request.__version__,
        "Accept-Encoding": "gzip",
        "Connection": "keep-alive",
    }

    # The same absolute deadline as the rest of the sweep, and a request that
    # arrived without one gets its own. Never tighter than the socket timeout
    # above, so a request whose deadline has already gone keeps the second that
    # timeout floor leaves it rather than losing the body it just asked for.
    body_deadline = time.time() + timeout
    if deadline is not None:
        body_deadline = max(deadline, body_deadline)

    while True:
        connection, reused = take_connection(host, timeout)
        try:
            connection.request("GET", target, headers=headers)
            response = connection.getresponse()
        except (http.client.HTTPException, OSError):
            drop_connection(host)
            # A kept connection the far end closed in the meantime fails before
            # a single byte leaves, so one retry on a fresh socket is free and
            # cannot repeat the request. A fresh socket failing is a real error.
            if reused:
                continue
            raise

        if response.status != 200:
            # Nothing is pipelined here, but a connection that answered with an
            # error is not worth keeping either.
            drop_connection(host)
            raise urllib.error.HTTPError(
                url, response.status, response.reason, response.headers, None
            )

        try:
            payload = read_body(response, body_deadline)
        except (http.client.HTTPException, OSError, ValueError):
            # Whatever went wrong - a limit, the deadline, a dead socket - the
            # body is half read and the connection is out of step with the
            # protocol, so it is closed rather than handed to the next request.
            # No retry either: the request was answered, just not acceptably.
            drop_connection(host)
            raise
        break

    if response.headers.get("Content-Encoding", "").lower() == "gzip":
        try:
            payload = gunzip_body(payload)
        except (OSError, ValueError):
            drop_connection(host)
            raise
    return json.loads(payload.decode("utf-8"))


def parse_kickoff(value):
    """ESPN stamps kickoffs as 2026-09-20T13:00Z, which fromisoformat rejects."""
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def parse_competitor(competitor):
    team = competitor.get("team") or {}
    score = competitor.get("score")
    return {
        "id": str(team.get("id") or ""),
        "abbr": team.get("abbreviation") or team.get("shortDisplayName") or "?",
        "name": team.get("shortDisplayName") or team.get("displayName") or "?",
        "fullName": team.get("displayName") or "",
        "logo": team.get("logo") or "",
        "color": "#" + (team.get("color") or "").lstrip("#") if team.get("color") else "",
        "score": str(score) if score not in (None, "") else "",
        "winner": bool(competitor.get("winner")),
    }


def parse_goals(competition):
    """The scoring plays ESPN attaches to a live match, oldest first."""
    goals = []
    for detail in competition.get("details") or []:
        if not detail.get("scoringPlay") or detail.get("shootout"):
            continue
        athletes = detail.get("athletesInvolved") or []
        scorer = ""
        if athletes:
            scorer = athletes[0].get("shortName") or athletes[0].get("displayName") or ""
        goals.append(
            {
                "minute": (detail.get("clock") or {}).get("displayValue") or "",
                "team": str((detail.get("team") or {}).get("id") or ""),
                "scorer": scorer,
                "ownGoal": bool(detail.get("ownGoal")),
                "penalty": bool(detail.get("penaltyKick")),
            }
        )
    return goals


def goal_keys(match_id, goals):
    """Stable identifiers for a match's goals.

    Keying on the scorer and the minute looked obvious and was wrong: ESPN
    publishes a scoring play with the name missing and fills it in a refresh or
    two later, and revises "45'" to "45'+2'". Either rewrote the key and the
    same goal was announced twice. The n-th goal for a side stays the n-th.
    """
    seen = {}
    keys = []
    for goal in goals:
        team = goal.get("team", "")
        seen[team] = seen.get(team, 0) + 1
        keys.append("%s|%s|%s" % (match_id, team, seen[team]))
    return keys


def parse_event(event, league_slug, league_name):
    competition = (event.get("competitions") or [{}])[0]
    competitors = competition.get("competitors") or []
    home = next((c for c in competitors if c.get("homeAway") == "home"), None)
    away = next((c for c in competitors if c.get("homeAway") == "away"), None)
    if home is None or away is None:
        return None

    status = competition.get("status") or {}
    status_type = status.get("type") or {}
    kickoff = parse_kickoff(competition.get("date") or event.get("date"))

    return {
        "id": str(event.get("id") or ""),
        "league": league_slug,
        "leagueName": league_name,
        "state": status_type.get("state") or "pre",
        "statusName": status_type.get("name") or "",
        "statusShort": status_type.get("shortDetail") or "",
        "statusDetail": status_type.get("detail") or "",
        "clock": status.get("displayClock") or "",
        "period": status.get("period") or 0,
        "kickoff": kickoff.isoformat() if kickoff else "",
        "kickoffEpoch": int(kickoff.timestamp()) if kickoff else 0,
        "kickoffLocal": kickoff.astimezone().strftime("%H:%M") if kickoff else "",
        "note": (competition.get("notes") or [{}])[0].get("headline", ""),
        "goals": parse_goals(competition),
        "home": parse_competitor(home),
        "away": parse_competitor(away),
    }


# Only the numbers worth a line in a bar popup, in the order they are shown.
SUMMARY_STATS = [
    ("possessionPct", "Possession", "%"),
    ("totalShots", "Shots", ""),
    ("shotsOnTarget", "On target", ""),
    ("wonCorners", "Corners", ""),
    ("yellowCards", "Yellow cards", ""),
    ("foulsCommitted", "Fouls", ""),
]

# The same six rows as Sofascore names them, so a Polish match reads exactly
# like an English one in the panel.
SOFA_STAT_KEYS = {
    "ballPossession": "possessionPct",
    "totalShotsOnGoal": "totalShots",
    "shotsOnGoal": "shotsOnTarget",
    "cornerKicks": "wonCorners",
    "yellowCards": "yellowCards",
    "fouls": "foulsCommitted",
}


def fetch_stats(league, event_id, deadline=None):
    """Per-team numbers for one match, from ESPN's summary endpoint.

    The scoreboard carries none of this, so it costs one extra request - hence
    only ever for the single match the panel has open.
    """
    if not valid_slug(league) or not valid_slug(str(event_id)):
        return None
    if league in SOFA_TOURNAMENTS:
        return fetch_sofascore_stats(str(event_id)[len(SOFA_PREFIX):], deadline)
    try:
        payload = read_json_url(
            "%s/%s/summary?event=%s" % (SITE_API, league, event_id), deadline
        )
    except NETWORK_ERRORS:
        return None

    teams = ((payload.get("boxscore") or {}).get("teams")) or []
    if len(teams) < 2:
        return None

    by_id = {}
    for team in teams:
        team_id = str((team.get("team") or {}).get("id") or "")
        values = {}
        for stat in team.get("statistics") or []:
            values[stat.get("name")] = stat.get("displayValue")
        by_id[team_id] = values

    rows = []
    for key, label, suffix in SUMMARY_STATS:
        present = [v.get(key) for v in by_id.values()]
        if not any(value not in (None, "") for value in present):
            continue
        rows.append({"key": key, "label": label, "suffix": suffix})

    return {
        "matchId": str(event_id),
        "at": int(time.time()),
        "teams": by_id,
        "rows": rows,
    }


def merge_stats(stored, fetched):
    """The open cards' numbers: the fresh ones, newest first, stale ones gone."""
    now = time.time()
    kept = {}
    for match_id, entry in (stored if isinstance(stored, dict) else {}).items():
        if isinstance(entry, dict) and now - float(entry.get("at") or 0) < STATS_AGE:
            kept[str(match_id)] = entry
    if fetched:
        kept[str(fetched["matchId"])] = fetched
    if len(kept) > STATS_KEEP:
        newest = sorted(kept.items(), key=lambda item: -float(item[1].get("at") or 0))
        kept = dict(newest[:STATS_KEEP])
    return kept


def valid_slug(slug):
    """Slugs are interpolated into a URL path; keep them to what ESPN uses."""
    return bool(slug) and bool(SLUG_PATTERN.match(slug))


# --------------------------------------------------------------- Sofascore
#
# The second source, for the competitions ESPN does not carry. Everything below
# ends in the same match dictionary parse_event builds, so nothing downstream -
# the sorting, the goal diff, the QML - knows there are two providers.


def sofa_season(tournament_id, cache_dir, deadline=None):
    """The season the current round sits in, cached for half a day."""
    key = str(tournament_id)
    path = os.path.join(cache_dir or ".", SOFA_SEASON_CACHE)
    cached = load_cache(path)
    entry = cached.get(key) if isinstance(cached, dict) else None
    if isinstance(entry, dict):
        try:
            fresh = time.time() - float(entry.get("at") or 0) < SOFA_SEASON_AGE
        except (TypeError, ValueError):
            fresh = False
        if fresh and entry.get("season") is not None:
            return entry["season"]

    payload = read_json_url(
        "%s/unique-tournament/%s/seasons" % (SOFA_API, tournament_id), deadline
    )
    seasons = payload.get("seasons") or []
    if not seasons:
        return None
    season = seasons[0].get("id")
    if season is None:
        return None
    if cache_dir:
        cached = cached if isinstance(cached, dict) else {}
        cached[key] = {"season": season, "at": int(time.time())}
        try:
            write_json_atomic(path, cached)
        except OSError:
            pass
    return season


# Sofascore's status.type, in the vocabulary the rest of the file speaks. The
# names are ESPN's, because Model.js reads them to tell a goalless draw from a
# match that was never played.
SOFA_STATES = {
    "inprogress": ("in", "STATUS_IN_PROGRESS"),
    "notstarted": ("pre", "STATUS_SCHEDULED"),
    "finished": ("post", "STATUS_FULL_TIME"),
    "postponed": ("post", "STATUS_POSTPONED"),
    "canceled": ("post", "STATUS_CANCELED"),
    "cancelled": ("post", "STATUS_CANCELED"),
    # Stopped but not over, and the score still stands. Not ABANDONED: Model.js
    # reads that word as a match that was never played and prints a dash where
    # the score should be, on a row still sitting under LIVE.
    "interrupted": ("in", "STATUS_SUSPENDED"),
    "suspended": ("in", "STATUS_SUSPENDED"),
    "abandoned": ("post", "STATUS_ABANDONED"),
    "willcontinue": ("in", "STATUS_IN_PROGRESS"),
}


def sofa_minute(event, now=None):
    """The running clock, as "67'" or "45'+2'".

    Sofascore sends the moment the current period started and how many seconds
    were already on the clock when it did; the minute is arithmetic from there.
    The half is not counted while the ball is not rolling, so a break returns
    its own label instead and Model.isBreak can tell the two apart.
    """
    status = event.get("status") or {}
    description = status.get("description") or ""
    if status.get("code") == 31 or description.lower() in ("halftime", "half time"):
        return "HT"

    clock = event.get("time") or {}
    start = clock.get("currentPeriodStartTimestamp")
    initial = clock.get("initial")
    if start is None or initial is None:
        # No minute to be had - around the whistle, or during a delay. Better
        # blank than the period's name: Model.isBreak reads any word as the
        # ball not rolling, and this is a match that may well be running.
        return ""
    elapsed = float(initial) + ((now if now is not None else time.time()) - float(start))
    if elapsed < 0:
        elapsed = 0.0
    limit = clock.get("max")
    if limit is not None and elapsed > float(limit):
        return "%d'+%d'" % (int(limit) // 60, int(elapsed - float(limit)) // 60 + 1)
    return "%d'" % (int(elapsed) // 60 + 1)


def sofa_competitor(team, score):
    colors = team.get("teamColors") or {}
    primary = colors.get("primary") or ""
    name = team.get("shortName") or team.get("name") or "?"
    return {
        "id": SOFA_PREFIX + str(team.get("id") or ""),
        "abbr": team.get("nameCode") or name[:3].upper() or "?",
        "name": name,
        "fullName": team.get("name") or "",
        "logo": "%s/team/%s/image" % (SOFA_API, team.get("id")) if team.get("id") else "",
        # Sofascore sends white for a club whose kit has no second colour, and
        # a white flash on a light bar is no flash at all. Model.readableColor
        # pushes it away from the bar, so only a missing value is dropped.
        "color": primary if primary.startswith("#") else "",
        "score": str(score) if score not in (None, "") else "",
        "winner": False,
    }


def sofa_goals(event_id, deadline=None):
    """The scoring plays for one match, oldest first, shaped like parse_goals."""
    try:
        payload = read_json_url(
            "%s/event/%s/incidents" % (SOFA_API, event_id), deadline
        )
    except NETWORK_ERRORS:
        return None

    goals = []
    # Sofascore lists the newest incident first; the goal keys downstream count
    # a side's goals in order, so they have to be turned round.
    for incident in reversed(payload.get("incidents") or []):
        if incident.get("incidentType") != "goal":
            continue
        kind = incident.get("incidentClass") or ""
        if kind == "penaltyShootout":
            continue
        player = incident.get("player") or {}
        minute = incident.get("time")
        added = incident.get("addedTime")
        if minute is None:
            label = ""
        elif added:
            label = "%d'+%d'" % (minute, added)
        else:
            label = "%d'" % minute
        goals.append(
            {
                "minute": label,
                # Filled in by sofa_event, which is where the two club ids are.
                "team": "",
                "scorer": player.get("shortName") or player.get("name") or "",
                "ownGoal": kind == "ownGoal",
                "penalty": kind == "penalty",
                "isHome": bool(incident.get("isHome")),
            }
        )
    return goals


def sofa_event(event, slug, league_name, goals):
    home_team = event.get("homeTeam") or {}
    away_team = event.get("awayTeam") or {}
    if not home_team.get("id") or not away_team.get("id"):
        return None

    status = event.get("status") or {}
    state, status_name = SOFA_STATES.get(
        (status.get("type") or "").lower(), ("pre", "STATUS_SCHEDULED")
    )
    home = sofa_competitor(home_team, (event.get("homeScore") or {}).get("current"))
    away = sofa_competitor(away_team, (event.get("awayScore") or {}).get("current"))

    # The incidents endpoint says which side a goal counts for, not which club
    # id; both are known only here, where the two teams are.
    resolved = []
    for goal in goals or []:
        entry = dict(goal)
        # Read, not consumed: these goals are written to the cache and handed
        # back in on a later sweep, and a goal that has forgotten which side it
        # was for comes back credited to the away club - wrong colour, wrong
        # scoreline, and a fresh goal key, so the whole match is announced again.
        entry["team"] = home["id"] if entry.get("isHome") else away["id"]
        resolved.append(entry)

    kickoff = event.get("startTimestamp")
    when = (
        datetime.fromtimestamp(kickoff, timezone.utc) if kickoff else None
    )
    if state == "in":
        short = sofa_minute(event)
    elif state == "post":
        short = "FT" if status_name == "STATUS_FULL_TIME" else (
            status.get("description") or ""
        )
    else:
        short = when.astimezone().strftime("%H:%M") if when else ""

    return {
        "id": SOFA_PREFIX + str(event.get("id") or ""),
        "league": slug,
        "leagueName": league_name,
        "state": state,
        "statusName": status_name,
        "statusShort": short,
        "statusDetail": status.get("description") or "",
        "clock": short if state == "in" else "",
        "period": 2 if (event.get("lastPeriod") or "") == "period2" else 1,
        "kickoff": when.isoformat() if when else "",
        "kickoffEpoch": int(kickoff) if kickoff else 0,
        "kickoffLocal": when.astimezone().strftime("%H:%M") if when else "",
        "note": "",
        "goals": resolved,
        "home": home,
        "away": away,
    }


def fetch_sofascore_league(slug, deadline=None, cache_dir=None, previous=None):
    """Return (slug, name, matches, error), same contract as fetch_league."""
    name = COMPETITION_LABELS.get(slug, slug)
    tournament = SOFA_TOURNAMENTS[slug]
    try:
        season = sofa_season(tournament, cache_dir, deadline)
        if season is None:
            return slug, name, [], "no current season"
        # Two windows rather than a fixture list for a date: the round that has
        # been played and the one coming, which between them always contain
        # today whatever day of the week it is.
        events = {}
        for window in ("last", "next"):
            payload = read_json_url(
                "%s/unique-tournament/%s/season/%s/events/%s/0"
                % (SOFA_API, tournament, season, window),
                deadline,
            )
            for event in payload.get("events") or []:
                if event.get("id"):
                    events[event["id"]] = event
    except NETWORK_ERRORS as error:
        return slug, name, [], str(error)
    except Exception as error:  # noqa: BLE001 - one league must not sink the run
        return slug, name, [], repr(error)

    before = {}
    for match in previous or []:
        if isinstance(match, dict) and match.get("id"):
            before[match["id"]] = match

    today = datetime.now().date()
    now = time.time()
    matches = []
    detailed = 0
    for event in events.values():
        try:
            skeleton = sofa_event(event, slug, name, None)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError):
            continue
        if skeleton is None or not is_today(skeleton, today, now):
            continue

        # The scorers are a request each, and a scoreline that has not moved
        # cannot have grown a goal since the last sweep. Without this a Sunday
        # afternoon of nine finished matches paid for nine requests every
        # twenty seconds to be told the same thing.
        goals = None
        prior = before.get(skeleton["id"])
        prior_goals = prior.get("goals") if prior else None
        # A goal is only reusable if it still says which side it was for. One
        # written by a version that dropped that flag would come back credited
        # to the away club, and since its score has not moved it would never be
        # fetched again - the cache would keep the mistake indefinitely.
        if prior_goals and not all("isHome" in goal for goal in prior_goals):
            prior_goals = None
        if prior_goals and scoreline_of(prior) == scoreline_of(skeleton):
            goals = prior_goals
        elif skeleton["state"] != "pre" and detailed < SOFA_MAX_DETAIL:
            detailed += 1
            goals = sofa_goals(str(event["id"]), deadline)
            # One failed request must not empty the match: an empty goal list
            # written to the cache is a match whose goals are all new again the
            # moment the next request succeeds.
            if goals is None:
                goals = prior_goals
        if goals:
            skeleton = sofa_event(event, slug, name, goals) or skeleton
        matches.append(skeleton)
    return slug, name, matches, None


def fetch_sofascore_stats(event_id, deadline=None):
    """Per-team numbers for one Sofascore match, in SUMMARY_STATS' vocabulary."""
    try:
        payload = read_json_url(
            "%s/event/%s/statistics" % (SOFA_API, event_id), deadline
        )
        event = read_json_url("%s/event/%s" % (SOFA_API, event_id), deadline)
    except NETWORK_ERRORS:
        return None

    periods = payload.get("statistics") or []
    if not periods:
        return None
    values = {}
    for group in periods[0].get("groups") or []:
        for item in group.get("statisticsItems") or []:
            key = SOFA_STAT_KEYS.get(item.get("key"))
            if key and key not in values:
                values[key] = (item.get("home"), item.get("away"))

    detail = event.get("event") or {}
    home_id = str((detail.get("homeTeam") or {}).get("id") or "")
    away_id = str((detail.get("awayTeam") or {}).get("id") or "")
    # Without both, the two sides would share one key and the panel would draw
    # a table of labels with no numbers under them.
    if not home_id or not away_id or home_id == away_id:
        return None
    home_id = SOFA_PREFIX + home_id
    away_id = SOFA_PREFIX + away_id

    def cell(value):
        # Zero is a number: "or" would turn a side's 0 corners into a blank
        # where the other side shows a figure.
        if value is None or value == "":
            return ""
        # Possession arrives as "64%" and the panel adds the sign itself.
        return str(value).replace("%", "")

    by_id = {home_id: {}, away_id: {}}
    rows = []
    for key, label, suffix in SUMMARY_STATS:
        pair = values.get(key)
        if pair is None:
            continue
        by_id[home_id][key] = cell(pair[0])
        by_id[away_id][key] = cell(pair[1])
        rows.append({"key": key, "label": label, "suffix": suffix})

    if not rows:
        return None
    return {
        "matchId": SOFA_PREFIX + str(event_id),
        "at": int(time.time()),
        "teams": by_id,
        "rows": rows,
    }


def fetch_sofascore_teams(slug, cache_dir=None):
    """The club picker's options for a Sofascore competition."""
    tournament = SOFA_TOURNAMENTS[slug]
    try:
        season = sofa_season(tournament, cache_dir)
        if season is None:
            return []
        payload = read_json_url(
            "%s/unique-tournament/%s/season/%s/teams" % (SOFA_API, tournament, season)
        )
    except NETWORK_ERRORS:
        return []
    league = COMPETITION_LABELS.get(slug, slug)
    teams = []
    for team in payload.get("teams") or []:
        if not team.get("id"):
            continue
        teams.append(
            {
                "value": SOFA_PREFIX + str(team["id"]),
                "label": team.get("name") or team.get("shortName") or "?",
                "description": league,
            }
        )
    return teams


def fetch_league(slug, deadline=None, cache_dir=None, previous=None):
    """Return (slug, name, matches, error). An error leaves matches empty."""
    if not valid_slug(slug):
        return slug, slug, [], "not a valid competition id"
    if slug in SOFA_TOURNAMENTS:
        return fetch_sofascore_league(slug, deadline, cache_dir, previous)
    try:
        payload = read_json_url("%s/%s/scoreboard" % (SITE_API, slug), deadline)
    except NETWORK_ERRORS as error:
        return slug, COMPETITION_LABELS.get(slug, slug), [], str(error)
    except Exception as error:  # noqa: BLE001 - one league must not sink the run
        return slug, COMPETITION_LABELS.get(slug, slug), [], repr(error)

    leagues = payload.get("leagues") or [{}]
    name = COMPETITION_LABELS.get(slug) or leagues[0].get("name") or slug

    matches = []
    for event in payload.get("events") or []:
        try:
            match = parse_event(event, slug, name)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError):
            # A single malformed fixture is not worth losing the competition
            # over, let alone every other one in the same run.
            continue
        if match is not None:
            matches.append(match)
    return slug, name, matches, None


def sort_key(match, favorites):
    involves_favorite = (
        match["home"]["id"] in favorites or match["away"]["id"] in favorites
    )
    state_rank = STATE_ORDER.get(match["state"], 3)
    # Finished matches read best newest first; everything else earliest first.
    time_rank = -match["kickoffEpoch"] if state_rank == 2 else match["kickoffEpoch"]
    return (state_rank, 0 if involves_favorite else 1, time_rank, match["id"])


def is_today(match, today, now):
    """Local calendar day, plus anything still being played and anything that
    finished in the last few hours - a 21:00 kickoff that ends after midnight
    belongs to the evening you watched it, not to yesterday."""
    if match["state"] == "in":
        return True
    if not match["kickoffEpoch"]:
        return False
    # Only a match that has already kicked off can be "recent"; for a future
    # fixture this difference is negative, which let every coming matchday
    # through.
    elapsed = now - match["kickoffEpoch"]
    if 0 <= elapsed < RECENT_MATCH_AGE:
        return True
    return datetime.fromtimestamp(match["kickoffEpoch"]).date() == today


def load_config(path):
    config = dict(DEFAULT_CONFIG)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            stored = json.load(handle)
    except (OSError, ValueError):
        return config
    if isinstance(stored, dict):
        config.update(stored)
    return config


def as_string_list(value):
    if isinstance(value, str):
        return [part for part in value.split(",") if part]
    if isinstance(value, (list, tuple)):
        return [str(item) for item in value if str(item)]
    return []


class FetchLock:
    """Exclusive across processes. The loser gives up rather than queueing.

    Queueing looked harmless until you follow it through: the second monitor's
    process would sit blocked for as long as the first one took, and a stalled
    endpoint froze both widgets indefinitely. Whatever the winner writes is
    what the loser wanted anyway.
    """

    def __init__(self, path):
        self.path = path
        self.handle = None
        self.acquired = False

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
        try:
            self.handle = open(self.path, "w")
            os.chmod(self.path, 0o600)
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.acquired = True
        except OSError as error:
            if self.handle:
                self.handle.close()
                self.handle = None
            if error.errno not in (errno.EACCES, errno.EAGAIN):
                raise
        return self

    def __exit__(self, *_):
        if not self.handle:
            return
        try:
            if self.acquired:
                fcntl.flock(self.handle, fcntl.LOCK_UN)
        finally:
            self.handle.close()
            self.handle = None


def load_cache(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def write_json_atomic(path, data):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=directory, delete=False
    )
    try:
        json.dump(data, handle, ensure_ascii=False)
        handle.flush()
        os.fsync(handle.fileno())
    finally:
        handle.close()
    os.replace(handle.name, path)


_warned = set()


def warn(message):
    """Say it once per run, on stderr, where the shell log picks it up.

    Quickshell keeps the helper's stderr, so this is the only channel a broken
    desktop notification has. Once per run rather than once per goal: a missing
    notify-send would otherwise write a line for every match in the sweep.
    """
    if message in _warned:
        return
    _warned.add(message)
    print("elevenmates: " + message, file=sys.stderr)


def notify(match, headline, detail="", score=None, clock=None):
    """`score` and `clock` describe the moment being announced.

    Without them the body reads off the scoreboard as it stands, which is right
    for a final whistle and wrong for a goal being caught up on: three goals
    found in one sweep would all have been reported at the score the third one
    left behind.
    """
    body = "%s %s %s  %s" % (
        match["home"]["name"],
        score or scoreline_of(match),
        match["away"]["name"],
        clock or match["clock"] or match["statusShort"],
    )
    if detail:
        body = detail + "\n" + body
    try:
        result = subprocess.run(
            ["notify-send", "-a", "Elevenmates", "-u", "low", headline, body],
            check=False,
            timeout=5,
            capture_output=True,
        )
    except FileNotFoundError:
        warn("notify-send is not installed, so goal alerts stay on the bar only")
        return
    except (OSError, subprocess.SubprocessError) as error:
        warn("notify-send could not be run: %s" % error)
        return
    if result.returncode != 0:
        detail_text = (result.stderr or b"").decode("utf-8", "replace").strip()
        warn(
            "notify-send exited %d%s"
            % (result.returncode, ": " + detail_text if detail_text else "")
        )


def safe_score(side):
    try:
        return int(side.get("score") or 0)
    except (TypeError, ValueError):
        return 0


def goals_scored(match):
    """Total goals on the board, as a number, for comparing two snapshots."""
    total = 0
    for side in ("home", "away"):
        try:
            total += int(match[side]["score"] or 0)
        except (TypeError, ValueError):
            return -1
    return total


def goal_note(goal):
    if goal["ownGoal"]:
        return "o.g."
    if goal["penalty"]:
        return "pen."
    return ""


def goal_headline(goal):
    """"Haaland 67' (pen.)" - what the bar flashes and the notification says."""
    scorer = goal["scorer"] or "Goal"
    if goal["ownGoal"]:
        scorer += " (o.g.)"
    elif goal["penalty"]:
        scorer += " (pen.)"
    return (scorer + " " + goal["minute"]).strip()


def score_at(match, goals, index):
    """The scoreline as it stood when goals[index] went in.

    Counted backwards from the scoreboard rather than forwards from nothing:
    the board is the one number that is certainly right, and ESPN sometimes
    publishes a match's scoring plays with an early one still missing.
    """
    home = safe_score(match["home"])
    away = safe_score(match["away"])
    for later in goals[index + 1:]:
        if later.get("team") == match["home"]["id"]:
            home -= 1
        else:
            away -= 1
    return "%d-%d" % (max(0, home), max(0, away))


def describe_goal(match, goal, seq, score=None):
    side = match["home"] if goal["team"] == match["home"]["id"] else match["away"]
    return {
        "seq": seq,
        "at": int(time.time()),
        "matchId": match["id"],
        "league": match["leagueName"],
        "team": side["abbr"],
        "teamName": side["name"],
        # The scoring club's own colour, for the bar to flash in.
        "teamColor": side["color"],
        "scorer": goal["scorer"] or "",
        "minute": goal["minute"],
        "note": goal_note(goal),
        "headline": goal_headline(goal),
        "score": score or scoreline_of(match),
        "home": match["home"]["abbr"],
        "away": match["away"]["abbr"],
    }


def scoreline_of(match):
    return "%s-%s" % (match["home"]["score"] or "0", match["away"]["score"] or "0")


def describe_score_move(match, old, seq):
    """A goal ESPN has moved the score for but not yet described.

    It arrives with no scorer and no minute of its own, which is exactly how it
    should read on the bar - "GOAL (Man City) 4-2" and no name - rather than not
    appearing at all until the detail catches up.
    """
    side = None
    for key in ("home", "away"):
        if safe_score(match[key]) > safe_score((old.get(key) or {})):
            side = match[key]
            break
    if side is None:
        return None
    minute = match["clock"] or match["statusShort"] or ""
    return {
        "seq": seq,
        "at": int(time.time()),
        "matchId": match["id"],
        "league": match["leagueName"],
        "team": side["abbr"],
        "teamName": side["name"],
        "teamColor": side["color"],
        "scorer": "",
        "minute": minute,
        "note": "",
        "headline": minute or "Goal",
        "score": scoreline_of(match),
        "home": match["home"]["abbr"],
        "away": match["away"]["abbr"],
        # Flagged so the scoring play, when it turns up a sweep or two later,
        # can take this entry's place instead of being a second celebration of
        # the same goal.
        "placeholder": True,
    }


def take_placeholder(feed, match_id):
    """Pull this match's oldest unnamed goal off the feed, if it has one."""
    for index, entry in enumerate(feed):
        if entry.get("placeholder") and entry.get("matchId") == match_id:
            return index, entry
    return None, None


def announce_changes(
    previous, matches, favorites, alerts, watched_ids, notify_all, notify_enabled,
    feed
):
    """Find what happened since the last run: goals, and any final whistle.

    Every goal found is appended to the feed so the bar can celebrate each one
    in turn, whether or not desktop notifications are on - but only for a match
    the user actually follows. A goal in some competition they merely subscribed
    to is not their business.
    """
    previous_matches = previous.get("matches") or []
    before = {m["id"]: m for m in previous_matches}
    seq = int((previous.get("lastGoal") or {}).get("seq") or 0)
    feed = list(feed)

    for match in matches:
        old = before.get(match["id"])
        if not isinstance(old, dict) or "state" not in old:
            # A cache written by an older version, or edited by hand. Skip the
            # comparison rather than raising and leaving the file unwritable.
            continue
        # The bell, a club you follow, or the match the bar is holding. Anything
        # else is a fixture that merely came along with its competition.
        watched = (
            notify_all
            or match["id"] in alerts
            or match["id"] in watched_ids
            or match["home"]["id"] in favorites
            or match["away"]["id"] in favorites
        )

        if not watched:
            continue

        seen = set(goal_keys(match["id"], old.get("goals") or []))
        current = match.get("goals") or []
        fresh = [
            (index, goal)
            for index, (goal, key) in enumerate(
                zip(current, goal_keys(match["id"], current))
            )
            if key not in seen
        ]
        if fresh and match["state"] != "pre":
            # Two goals can land inside one refresh interval, and both deserve
            # their own celebration rather than only the later one - each at the
            # score it was actually scored at.
            for index, goal in fresh:
                score = score_at(match, current, index)
                # This may be the goal an unnamed one already stood for. If so
                # it takes that entry's place, keeping its number and its time
                # so the bar does not celebrate the same goal twice, and no
                # second notification goes out for it either.
                slot, placeholder = take_placeholder(feed, match["id"])
                if placeholder is not None:
                    named = describe_goal(match, goal, placeholder["seq"], score)
                    named["at"] = placeholder["at"]
                    feed[slot] = named
                    continue

                seq += 1
                entry = describe_goal(match, goal, seq, score)
                feed.append(entry)
                if notify_enabled:
                    notify(
                        match,
                        "Goal - " + match["leagueName"],
                        entry["teamName"] + ": " + entry["headline"],
                        entry["score"],
                        goal.get("minute") or None,
                    )
        elif match["state"] == "in" and goals_scored(match) > goals_scored(old):
            # A score that moved without a scoring play behind it, which happens
            # while ESPN is still filling in the detail. Only upwards: VAR and
            # score corrections move it back down, and that is not a goal.
            #
            # This goes on the feed like any other. It used to raise a desktop
            # notification and nothing else, so with alerts switched off the one
            # case the bar flash exists to cover was the one case it missed.
            seq += 1
            entry = describe_score_move(match, old, seq)
            if entry is not None:
                feed.append(entry)
            if notify_enabled:
                notify(match, "Goal - " + match["leagueName"])

        if notify_enabled and match["state"] == "post" and old["state"] == "in":
            notify(match, "Full time - " + match["leagueName"])

    return feed[-GOAL_FEED_KEEP:]


def prune_follows(config_path, config, matches, errors, leagues):
    """Forget bells and a pin whose match has left today's card.

    Only after a clean sweep: a competition that failed to answer keeps its
    previous matches, but one that failed before it was ever read would look
    like every match in it had simply ended, and would quietly clear the very
    row the bar is sitting on.
    """
    if not leagues or errors:
        return
    current = {match["id"] for match in matches}

    # Read the file again and decide from that, not from the copy this run
    # started with: a sweep can take most of a minute, and a pin set while it
    # was in flight would otherwise be cleared for not being on a card that was
    # fetched before it existed.
    stored = load_config(config_path)
    alerts = as_string_list(stored.get("alertMatches"))
    kept = [match_id for match_id in alerts if match_id in current]
    pinned = str(stored.get("pinnedMatch") or "")

    changed = {}
    if len(kept) != len(alerts):
        changed["alertMatches"] = kept
    if pinned and pinned not in current:
        changed["pinnedMatch"] = ""
    if not changed:
        return

    stored.update(changed)
    try:
        write_json_atomic(config_path, stored)
    except OSError:
        pass


def command_fetch(args):
    lock_path = os.path.join(os.path.dirname(args.out) or ".", LOCK_NAME)
    with FetchLock(lock_path) as lock:
        if not lock.acquired:
            # Another monitor's widget is already doing exactly this.
            return 0
        return fetch_once(args)


def fetch_once(args):
    # On a machine that has never run this, write the defaults out before doing
    # anything else. The widget reads the file, not the helper's idea of the
    # defaults, and without this a fresh install fetched ten competitions while
    # the bar insisted none were picked.
    if not os.path.exists(args.config):
        write_json_atomic(args.config, dict(DEFAULT_CONFIG))

    config = load_config(args.config)
    leagues = as_string_list(config.get("leagues"))
    favorites = set(as_string_list(config.get("favoriteTeams")))
    notify_enabled = bool(config.get("goalNotifications", True))
    notify_all = bool(config.get("notifyAll", False))
    alerts = set(as_string_list(config.get("alertMatches")))
    # The guard exists to stop a post-suspend cache being diffed as fresh news.
    # A fixed twenty minutes silently disabled goal alerts for anyone who set a
    # longer idle interval, so it has to clear that interval by a margin.
    try:
        idle_minutes = float(config.get("idleRefreshMin") or 20)
    except (TypeError, ValueError):
        idle_minutes = 20
    # It has to clear the longest gap the widget will actually leave, which is
    # the stretched idle interval, not the plain one.
    stale_age = max(
        STALE_CACHE_AGE, idle_minutes * 60 * 2.5, IDLE_STRETCH_CAP + 5 * 60
    )
    pinned = str(config.get("pinnedMatch") or "")
    # Whatever the bar is actually carrying counts too, otherwise a default
    # install - no favourites, no bells, nothing pinned - would watch the bar
    # change from 0-0 to 1-0 with no alert at all.
    watched_ids = {pinned, str(args.headline or "")} - {""}
    previous = load_cache(args.out)
    # Clamped at zero: a cache stamped in the future - a clock step, a restore
    # from a machine that was ahead - would otherwise read as forever fresh and
    # every fetch would degrade to a no-op until wall-clock time caught up.
    age = max(0.0, time.time() - float(previous.get("updatedAt") or 0))
    deadline = time.time() + FETCH_BUDGET

    # Another monitor's widget just did this. Fetch the statistics if they are
    # what is actually missing, and otherwise leave the file alone. A refresh
    # the user asked for by hand is never skipped.
    if previous.get("matches") and age < MIN_REFRESH_AGE and not args.force:
        return refresh_stats_only(args, previous, deadline)

    previous_matches = previous.get("matches") or []
    previous_by_league = {}
    for match in previous_matches:
        if isinstance(match, dict) and match.get("league"):
            previous_by_league.setdefault(match["league"], []).append(match)

    matches = []
    errors = []
    league_names = {}
    cache_dir = os.path.dirname(args.out) or "."
    if leagues:
        workers = min(MAX_PARALLEL_REQUESTS, len(leagues))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            results = list(
                pool.map(
                    lambda slug: fetch_league(
                        slug, deadline, cache_dir, previous_by_league.get(slug)
                    ),
                    leagues,
                )
            )
        for slug, name, league_matches, error in results:
            league_names[slug] = name
            if error is None:
                matches.extend(league_matches)
            else:
                # Keep yesterday's answer rather than emptying the bar.
                matches.extend(previous_by_league.get(slug, []))
                errors.append("%s: %s" % (name, error))

    today = datetime.now().date()
    now = time.time()
    matches = [match for match in matches if is_today(match, today, now)]

    for match in matches:
        match["favorite"] = (
            match["home"]["id"] in favorites or match["away"]["id"] in favorites
        )
    matches.sort(key=lambda match: sort_key(match, favorites))

    last_goal = previous.get("lastGoal")
    stored_feed = previous.get("goalFeed")
    feed = list(stored_feed) if isinstance(stored_feed, list) else []
    # After a suspend the cache describes a different afternoon; diffing it
    # would fire a burst of notifications for matches that ended hours ago.
    if previous_matches and age < stale_age:
        feed = announce_changes(
            previous, matches, favorites, alerts, watched_ids,
            notify_all, notify_enabled, feed
        )
        if feed:
            last_goal = feed[-1]

    # Bells and the pin name a match, and a match id is good for one day. Left
    # alone they pile up in the config file for every Saturday ever watched.
    prune_follows(args.config, config, matches, errors, leagues)

    # A run without --stats must not wipe the numbers another monitor's open
    # panel is reading, and a run with one must not evict them either.
    stats = merge_stats(previous.get("statsByMatch"), None)
    if args.stats and ":" in args.stats:
        league, _, event_id = args.stats.partition(":")
        fetched = fetch_stats(league, event_id, deadline)
        if fetched is not None:
            stats = merge_stats(stats, fetched)

    state = {
        "updatedAt": int(time.time()),
        "statsByMatch": stats,
        "leagues": league_names,
        "error": "; ".join(errors) if errors else "",
        "liveCount": sum(1 for match in matches if match["state"] == "in"),
        "lastGoal": last_goal,
        "goalFeed": feed,
        "matches": matches,
    }
    write_json_atomic(args.out, state)
    return 1 if errors and not matches else 0


def command_config(args):
    config = load_config(args.config)
    if args.action == "show":
        json.dump(config, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.action == "get":
        json.dump(config.get(args.key), sys.stdout, ensure_ascii=False)
        return 0

    if args.key not in DEFAULT_CONFIG:
        print("unknown setting: %s" % args.key, file=sys.stderr)
        return 1
    try:
        value = json.loads(args.value)
    except ValueError:
        print("value is not JSON: %s" % args.value, file=sys.stderr)
        return 1
    config[args.key] = value
    write_json_atomic(args.config, config)
    return 0


def command_demo(args):
    """Fire the goal alert once, off a real match in the cache.

    There is no other way to see what a goal looks like without waiting for
    one, and waiting is a poor way to check a colour.
    """
    state = load_cache(args.out)
    matches = state.get("matches") or []
    if not matches:
        print("no cached matches yet - let the widget refresh first", file=sys.stderr)
        return 1

    # Prefer a match one of the followed clubs is in, and credit the goal to
    # that club: the alert then looks like the real thing and exercises the
    # same "watched" path a real goal takes.
    config = load_config(args.config)
    favorites = set(as_string_list(config.get("favoriteTeams")))
    live = [m for m in matches if m["state"] == "in"] or matches

    match = live[0]
    side = match["home"]
    for candidate in live:
        for key in ("home", "away"):
            if candidate[key]["id"] in favorites:
                match, side = candidate, candidate[key]
                break
        else:
            continue
        break

    goal = {
        "seq": int((state.get("lastGoal") or {}).get("seq") or 0) + 1,
        "at": int(time.time()),
        "matchId": match["id"],
        "league": match["leagueName"],
        "team": side["abbr"],
        "teamName": side["name"],
        "teamColor": side["color"],
        "scorer": args.scorer,
        "minute": match["clock"] or "1'",
        "note": "",
        "headline": (args.scorer + " " + (match["clock"] or "1'")).strip(),
        # The real score has not moved, so the demo adds the goal it claims to
        # be announcing - "GOAL" next to 0-0 reads as a bug.
        "score": "%s-%s" % (
            safe_score(match["home"]) + 1,
            safe_score(match["away"]),
        ),
        "home": match["home"]["abbr"],
        "away": match["away"]["abbr"],
    }
    feed = state.get("goalFeed")
    feed = list(feed) if isinstance(feed, list) else []
    feed.append(goal)
    state["goalFeed"] = feed[-GOAL_FEED_KEEP:]
    state["lastGoal"] = goal
    write_json_atomic(args.out, state)
    print("goal alert fired: %s for %s" % (args.scorer, side["name"]))
    return 0


def refresh_stats_only(args, previous, deadline=None):
    """The scoreboards are fresh enough; only the open match may need numbers."""
    if not args.stats or ":" not in args.stats:
        return 0
    league, _, event_id = args.stats.partition(":")
    stored = previous.get("statsByMatch")
    stored = stored if isinstance(stored, dict) else {}
    current = stored.get(str(event_id))
    if isinstance(current, dict) and time.time() - float(current.get("at") or 0) < MIN_REFRESH_AGE:
        return 0
    fetched = fetch_stats(league, event_id, deadline)
    if fetched is None:
        return 0
    previous["statsByMatch"] = merge_stats(stored, fetched)
    write_json_atomic(args.out, previous)
    return 0


def command_leagues(_args):
    json.dump(
        [
            {"value": slug, "label": label, "description": region}
            for slug, label, region in COMPETITIONS
        ],
        sys.stdout,
        ensure_ascii=False,
    )
    return 0


def fetch_teams(slug, cache_dir=None):
    if slug in SOFA_TOURNAMENTS:
        return fetch_sofascore_teams(slug, cache_dir)
    try:
        payload = read_json_url("%s/%s/teams" % (SITE_API, slug))
    except NETWORK_ERRORS:
        return []
    try:
        entries = payload["sports"][0]["leagues"][0]["teams"]
    except (KeyError, IndexError, TypeError):
        return []
    league = COMPETITION_LABELS.get(slug, slug)
    teams = []
    for entry in entries:
        team = entry.get("team") or {}
        if not team.get("id"):
            continue
        teams.append(
            {
                "value": str(team["id"]),
                "label": team.get("displayName") or team.get("shortDisplayName") or "?",
                "description": league,
            }
        )
    return teams


def command_teams(args):
    leagues = as_string_list(load_config(args.config).get("leagues"))
    cache_path = os.path.join(os.path.dirname(args.out) or ".", TEAMS_CACHE_NAME)
    cached = load_cache(cache_path)
    if (
        cached.get("leagues") == leagues
        and time.time() - float(cached.get("updatedAt") or 0) < TEAMS_CACHE_AGE
        and cached.get("options")
    ):
        json.dump(cached["options"], sys.stdout, ensure_ascii=False)
        return 0

    by_id = {}
    if leagues:
        workers = min(MAX_PARALLEL_REQUESTS, len(leagues))
        with ThreadPoolExecutor(max_workers=workers) as pool:
            fetch = lambda slug: fetch_teams(slug, os.path.dirname(args.out) or ".")
            for teams in pool.map(fetch, leagues):
                for team in teams:
                    # A club in two competitions is listed once, under the first.
                    by_id.setdefault(team["value"], team)
    options = sorted(by_id.values(), key=lambda team: team["label"].lower())
    if options:
        write_json_atomic(
            cache_path,
            {"updatedAt": int(time.time()), "leagues": leagues, "options": options},
        )
    json.dump(options, sys.stdout, ensure_ascii=False)
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog="elevenmates", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    # Accepted on either side of the subcommand. They cannot share a dest: the
    # subparser writes its own default over whatever the top-level one parsed,
    # so `elevenmates --config mine.json config set ...` used to read and then
    # rewrite the real config file instead of the one asked for.
    parser.add_argument(
        "--config", default=CONFIG_PATH, dest="global_config", metavar="PATH"
    )

    def with_config(sub):
        sub.add_argument("--config", default=None, metavar="PATH")
        return sub


    fetch = with_config(commands.add_parser("fetch", help="refresh the score cache"))
    fetch.add_argument("--out", default=STATE_PATH)
    fetch.add_argument(
        "--force",
        action="store_true",
        help="refresh even if another widget just did; for a manual refresh",
    )
    fetch.add_argument(
        "--headline",
        default="",
        help="the match the bar is currently showing, so its goals count as watched",
    )
    fetch.add_argument(
        "--stats",
        default="",
        help="<league>:<event> - also fetch that one match's team statistics",
    )
    fetch.set_defaults(handler=command_fetch)

    config = with_config(commands.add_parser("config", help="read or change a setting"))
    config.add_argument("action", choices=("show", "get", "set"))
    config.add_argument("key", nargs="?", default="")
    config.add_argument("value", nargs="?", default="")
    config.set_defaults(handler=command_config)

    demo = with_config(commands.add_parser("demo-goal", help="fire the goal alert once"))
    demo.add_argument("--out", default=STATE_PATH)
    demo.add_argument("--scorer", default="David Beckham")
    demo.set_defaults(handler=command_demo)

    leagues = with_config(commands.add_parser("leagues", help="competition picker options"))
    leagues.set_defaults(handler=command_leagues)

    teams = with_config(commands.add_parser("teams", help="team picker options"))
    teams.add_argument("--out", default=STATE_PATH)
    teams.set_defaults(handler=command_teams)

    args = parser.parse_args(argv)
    if getattr(args, "config", None) is None:
        args.config = args.global_config
    return args.handler(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
